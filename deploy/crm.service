[Unit]
Description=CRM Django (gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/crm-django
EnvironmentFile=/srv/crm-django/.env
ExecStart=/srv/crm-django/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8101 --workers 3
Restart=on-failure

[Install]
WantedBy=multi-user.target
